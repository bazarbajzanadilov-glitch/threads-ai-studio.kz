[Unit]
Description=Threads Auto-Publisher Service (Node.js)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/thread.ai-studio.kz
Environment=NODE_ENV=production
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=always
RestartSec=5

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
