# ==============================================================================
# Threads Auto-Publisher — Environment Configuration
# Production VPS: 89.207.249.39 | Domain: threads.ai-studio.kz
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Configuration
# ------------------------------------------------------------------------------
# Port for the Node.js Express server to listen on (default: 3000)
PORT=3000

# Host network interface to bind (default: 0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Node environment mode: "production" or "development" (default: production)
NODE_ENV=production

# Public canonical URL of this application
# Crucial: used for Meta Graph API container image retrieval and OAuth callbacks
# Format: https://<domain> without trailing slash
BASE_URL=https://threads.ai-studio.kz

# ------------------------------------------------------------------------------
# 2. Admin Authentication
# ------------------------------------------------------------------------------
# Primary administrator email for web panel login
ADMIN_EMAIL=bazarbajzanadilov@gmail.com

# Secondary administrator email for web panel login
SECOND_ADMIN_EMAIL=reli.sheets1@gmail.com

# Secret session key / bearer token for admin authentication & API protection
SESSION_SECRET=admin_master_secret_2026

# ------------------------------------------------------------------------------
# 3. Meta Threads Graph API (OAuth Flow)
# ------------------------------------------------------------------------------
# Optional if connecting accounts via direct Long-Lived Access Tokens.
# Required only if using official Meta Threads OAuth redirect authorization flow.
THREADS_APP_ID=
THREADS_APP_SECRET=

# Meta Graph API endpoint and version (safe defaults provided in code)
THREADS_GRAPH_BASE_URL=https://graph.threads.net
THREADS_API_VERSION=v24.0

# ------------------------------------------------------------------------------
# 4. Storage & Database Paths
# ------------------------------------------------------------------------------
# Base data directory (relative or absolute path)
DATA_DIR=./data

# Directory for locally stored post images served to Meta crawlers
UPLOADS_DIR=./data/uploads

# SQLite database file path
DB_PATH=./data/threads.db

# ------------------------------------------------------------------------------
# 5. Admin Frontend Dev Proxy (Development Only)
# ------------------------------------------------------------------------------
# Vite dev server reverse proxy target when running `npm run dev` in apps/admin
VITE_DEV_API_ORIGIN=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 6. CLI & Agent Integration (Optional)
# ------------------------------------------------------------------------------
# API URL for @publisher/cli command line client
PUBLISHER_API_URL=http://localhost:3000/api

# Agent authentication token for CLI operations
PUBLISHER_API_TOKEN=admin_master_secret_2026
